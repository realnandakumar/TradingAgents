# TradingAgents environment template
# Copy to .env and fill in values for your chosen LLM provider (see README).
# Loaded automatically from the repo root when you import tradingagents or run the CLI.

# --- Pick ONE provider and set its API key ---

# OpenAI (default provider if TRADINGAGENTS_LLM_PROVIDER is unset)
# OPENAI_API_KEY=sk-your-openai-key

# DeepSeek (common low-cost option — uncomment block below)
DEEPSEEK_API_KEY=your-deepseek-key-here
TRADINGAGENTS_LLM_PROVIDER=deepseek
TRADINGAGENTS_QUICK_THINK_LLM=deepseek-v4-flash
TRADINGAGENTS_DEEP_THINK_LLM=deepseek-v4-pro

# Other providers (set TRADINGAGENTS_LLM_PROVIDER to match)
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# DASHSCOPE_API_KEY=
# DASHSCOPE_CN_API_KEY=
# ZHIPU_API_KEY=
# ZHIPU_CN_API_KEY=
# MINIMAX_API_KEY=
# MINIMAX_CN_API_KEY=
# OPENROUTER_API_KEY=
# AZURE_OPENAI_API_KEY=

# --- Local / optional ---
# OLLAMA_BASE_URL=http://localhost:11434/v1
# TRADINGAGENTS_LLM_PROVIDER=ollama
# ALPHA_VANTAGE_API_KEY=

# --- Optional TradingAgents config overrides (see tradingagents/default_config.py) ---
# TRADINGAGENTS_TECH_WATCHLIST_PATH=C:\path\to\watchlist.txt
# TRADINGAGENTS_TECH_DESK_MAX_REPORT_AGE_DAYS=21
