# TradingAgents environment template
# Copy to .env and fill in values for your chosen LLM provider (see README).
# Loaded automatically from the repo root via python-dotenv (tradingagents package import).

# --- LLM providers (set at least one) ---
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# DASHSCOPE_CN_API_KEY=
# ZHIPU_API_KEY=
# ZHIPU_CN_API_KEY=
# MINIMAX_API_KEY=
# MINIMAX_CN_API_KEY=
# OPENROUTER_API_KEY=
# AZURE_OPENAI_API_KEY=

# --- Local / optional ---
# OLLAMA_BASE_URL=http://localhost:11434/v1
# ALPHA_VANTAGE_API_KEY=

# --- Optional TradingAgents config overrides (see tradingagents/default_config.py) ---
# TRADINGAGENTS_LLM_PROVIDER=deepseek
# TRADINGAGENTS_QUICK_THINK_LLM=deepseek-chat
# TRADINGAGENTS_DEEP_THINK_LLM=deepseek-chat
