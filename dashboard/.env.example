# Frontend (Vercel) — safe to expose; the publishable key is read-only via RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# New Supabase key (sb_publishable_...). The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY
# is also still accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
